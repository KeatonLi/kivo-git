{
  "name": "idea-git",
  "displayName": "Kivo Git",
  "description": "An IDEA-style Git workflow for VS Code: commit changes on the left, inspect history in the bottom Panel.",
  "version": "0.3.0-beta.25",
  "publisher": "keatonli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KeatonLi/kivo-git.git"
  },
  "icon": "media/kivo-icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Source Control",
    "Other"
  ],
  "keywords": [
    "git",
    "changelist",
    "history",
    "graph",
    "workflow",
    "source-control"
  ],
  "activationEvents": [
    "onView:ideaGit.changes",
    "onView:ideaGit.history"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "media",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit && node --check media/graph-layout.js && node --check media/main.js && node --check scripts/release.mjs && node --check scripts/sync-assets.mjs && node --check scripts/verify-vsix.mjs && node --check scripts/test-extension.mjs && node --check scripts/test-webview.mjs && node --check scripts/visual-server.mjs",
    "sync-assets": "node scripts/sync-assets.mjs",
    "compile": "npm run sync-assets && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "dev": "node scripts/visual-server.mjs",
    "test": "vitest run",
    "test:webview": "node scripts/test-webview.mjs",
    "test:extension": "npm run compile && node scripts/test-extension.mjs",
    "test:vsix": "node scripts/verify-vsix.mjs kivo-git-${npm_package_version}.vsix",
    "package": "npm run check && npm run test && npm run compile && vsce package --out kivo-git-${npm_package_version}.vsix && npm run test:vsix",
    "release": "node scripts/release.mjs"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ideaGitChanges",
          "title": "Kivo Git",
          "icon": "media/logo.svg"
        }
      ],
      "panel": [
        {
          "id": "ideaGitHistory",
          "title": "Kivo Git History",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "ideaGitChanges": [
        {
          "type": "webview",
          "id": "ideaGit.changes",
          "name": "Commit"
        }
      ],
      "ideaGitHistory": [
        {
          "type": "webview",
          "id": "ideaGit.history",
          "name": "History"
        }
      ]
    },
    "commands": [
      {
        "command": "ideaGit.refresh",
        "title": "Kivo Git: Refresh"
      },
      {
        "command": "ideaGit.focus",
        "title": "Kivo Git: Show Changes"
      },
      {
        "command": "ideaGit.showChanges",
        "title": "Kivo Git: Show Changes"
      },
      {
        "command": "ideaGit.showLog",
        "title": "Kivo Git: Show History",
        "icon": "$(history)"
      },
      {
        "command": "ideaGit.openResourceDiff",
        "title": "Open Kivo Diff",
        "icon": "$(diff)"
      },
      {
        "command": "ideaGit.showFileHistory",
        "title": "Show File History",
        "icon": "$(history)"
      },
      {
        "command": "ideaGit.moveResourceToChangelist",
        "title": "Move to Changelist…",
        "icon": "$(list-selection)"
      },
      {
        "command": "ideaGit.showResourceInChanges",
        "title": "Show in Kivo Commit",
        "icon": "$(git-commit)"
      }
    ],
    "submenus": [
      {
        "id": "ideaGit.explorer",
        "label": "Kivo Git"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ideaGit.showLog",
          "when": "view == ideaGit.changes",
          "group": "navigation@1"
        },
        {
          "command": "ideaGit.refresh",
          "when": "view == ideaGit.changes || view == ideaGit.history",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "submenu": "ideaGit.explorer",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "scm@50"
        }
      ],
      "ideaGit.explorer": [
        {
          "command": "ideaGit.openResourceDiff",
          "group": "1_review@1"
        },
        {
          "command": "ideaGit.showFileHistory",
          "group": "1_review@2"
        },
        {
          "command": "ideaGit.showResourceInChanges",
          "group": "2_navigate@1"
        },
        {
          "command": "ideaGit.moveResourceToChangelist",
          "group": "3_changelist@1"
        }
      ]
    },
    "configuration": {
      "title": "Kivo Git",
      "properties": {
        "ideaGit.autoRefreshInterval": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "description": "Fallback refresh interval in milliseconds while the Kivo Git view is visible. File changes also trigger an immediate debounced refresh."
        },
        "ideaGit.autoFetch": {
          "type": "boolean",
          "default": true,
          "description": "Periodically fetch remote refs while the Kivo Git view is visible so incoming and outgoing commit counts stay current."
        },
        "ideaGit.autoFetchInterval": {
          "type": "number",
          "default": 300000,
          "minimum": 60000,
          "description": "Minimum interval in milliseconds between automatic background fetches."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
